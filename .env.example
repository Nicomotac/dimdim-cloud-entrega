# Configuração LOCAL para Bash. Copie para .env e preencha fora do GitHub.
# Use aspas simples para valores com $, !, espaços ou ponto e vírgula.
# Não use comandos neste arquivo: os scripts carregam seu conteúdo com source.
AZ_SUBSCRIPTION_ID=''
PREFIX=''
LOCATION='canadacentral'
GITHUB_REPOSITORY=''
GITHUB_BRANCH='main'
APP_SERVICE_SKU='B1'
SQL_SERVICE_OBJECTIVE='Basic'

# Opcionais: se vazios, 01-provisionar.sh solicita em entrada oculta.
SQL_ADMIN=''
SQL_PASSWORD=''
APP_USERNAME=''
APP_PASSWORD=''

# Somente para executar a aplicação localmente contra Azure SQL.
# DB_URL: URL JDBC do seu banco, sem usuário/senha embutidos.
DB_URL=''
DB_USERNAME=''
DB_PASSWORD=''
